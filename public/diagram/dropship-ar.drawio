ship-site/diagram/icons/shield-check-3b4d61.svg;" vertex="1" parent="1"><mxGeometry x="466" y="244" width="20" height="20" as="geometry"/></mxCell><mxCell id="wfp_l_en" value="&lt;b&gt;Windows Filtering Platform (WFP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;dropship&#x27;s filters drop Overwatch.exe traffic to the IP blocks of every&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;blocked region — nothing else is touched&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="502" y="232" width="436" height="74" as="geometry"/></mxCell><mxCell id="what_en" value="" style="rounded=1;arcSize=14;html=1;fillColor=#e6f7f3;strokeColor=#0f766e;fontSize=1;" vertex="1" parent="1"><mxGeometry x="990" y="228" width="200" height="82" as="geometry"/></mxCell><mxCell id="what_i_en" value="" style="shape=image;image=https://ryanathlawi.github.io/dropship-site/diagram/icons/info-0f766e.svg;" vertex="1" parent="1"><mxGeometry x="1006" y="244" width="20" height="20" as="geometry"/></mxCell><mxCell id="what_l_en" value="&lt;b&gt;What dropship is&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;a firewall rule set for the&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;game&#x27;s regions — no VPN, no&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;proxy, no injection&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1042" y="232" width="136" height="74" as="geometry"/></mxCell><mxCell id="shot_en" value="" style="shape=image;imageAspect=0;image=https://ryanathlawi.github.io/dropship-site/diagram/thumbs/launcher.webp?v=3.1.4;rounded=1;strokeCo