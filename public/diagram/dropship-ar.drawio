 style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#14b8a6;fontColor=#0b1220;fontSize=13;align=center;verticalAlign=top;spacing=6;textDirection=rtl;" vertex="1" parent="1"><mxGeometry x="452" y="230" width="190" height="130" as="geometry"/></mxCell><mxCell id="sa5_stages_ar" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452" y="295" as="sourcePoint"/><mxPoint x="436" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="img4_stages_ar" value="" style="shape=image;imageAspect=1;image=https://ryanathlawi.github.io/dropship-site/img/ar-main-dark.webp;rounded=1;strokeColor=#14b8a6;" vertex="1" parent="1"><mxGeometry x="658" y="90" width="190" height="130" as="geometry"/></mxCell><mxCell id="stg4_stages_ar" value="&lt;font color=&quot;#4b5563&quot; style=&quot;font-size:10px&quot;&gt;2026-09-21&lt;/font&gt;&lt;br&gt;&lt;b&gt;v3.1.0 — اللانشر&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;خريطة عالم حيّة، أعلام، أفضل مسار،&lt;br&gt;اختصارات حظر بمفاتيح، جولة من 14 خطوة&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#14b8a6;fontColor=#0b1220;fontSize=13;align=center;verticalAlign=top;spacing=6;textDirection=rtl;" vertex="1" parent="1"><mxGeometry x="658" y="230" width="190" height="130" as="geometry"/></mxCell><mxCell id="sa4_stages_ar" style="edgeStyle=none;html=1;strokeColor=#334155;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="658" y="295" as="sourcePoint"/><mxPoint x="642" y="295" as="targetPoint"/></mxGeometry></mxCell><mxCell id="img3_stages_ar" value="" style="shape=image;imageAspect=1;image=https://ryanathlawi.github.io/dropship-site/img/ar-presets.webp;rounded=1;strokeColor=#14b8a6;" vertex="1" parent="1"><mxGeometry x="864" y="90" width="190" height="130" as="geometry"/></mxCel