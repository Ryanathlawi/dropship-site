t;old exe to .deleteme, restart&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1344" y="846" width="208" height="76" as="geometry"/></mxCell><mxCell id="rel_en" value="" style="rounded=1;arcSize=14;html=1;fillColor=#ffffff;strokeColor=#d8dee6;shadow=1;fontSize=1;" vertex="1" parent="1"><mxGeometry x="1580" y="842" width="272" height="84" as="geometry"/></mxCell><mxCell id="rel_i_en" value="" style="shape=image;image=https://ryanathlawi.github.io/dropship-site/diagram/icons/package-5b48a8.svg;" vertex="1" parent="1"><mxGeometry x="1596" y="858" width="20" height="20" as="geometry"/></mxCell><mxCell id="rel_l_en" value="&lt;b&gt;Releases&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;one exe per tag; every copy compares&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;tags every 2.5 h&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1632" y="846" width="208" height="76" as="geometry"/></mxCell><mxCell id="gh_note_en" value="" style="rounded=1;arcSize=14;html=1;fillColor=#ffffff;strokeColor=#d8dee6;shadow=1;fontSize=1;" vertex="1" parent="1"><mxGeometry x="1292" y="944" width="560" height="84" as="geometry"/></mxCell><mxCell id="gh_note_i_en" value="" style="shape=image;image=https://ryanathlawi.github.io/dropship-site/diagram/icons/git-fork-5b48a8.svg;" vertex="1" parent="1"><mxGeometry x="1308" y="960" width="20" height="20" as="geometry"/></mxCell><mxCell id="gh_note_l_en" value="&lt;b&gt;Upstream — stowmyy/dropship&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;built on it under GPL-3.0; every feature here was sent back in PR #38. Adding a&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;language: one JSON file in lang/ and one enum entry — missing keys fall back to&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;English.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1344" y="948" width="496" height="76" as="geometry"/></mxCell><mxCell id="life_axis_en" style="edgeStyle=none;strokeColor=#0f766e;strokeWidth=2;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="1210" as="sourcePoint"/><mxPoint x="1770" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n0_en" value="1" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="141" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n0_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;LAUNCH&lt;/font&gt;&lt;br&gt;&lt;b&gt;dropship.exe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;double-click; the manifest&lt;br&gt;asks for admin&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="50" y="1114" width="200" height="80" as="geometry"/></mxCell><mxCell id="n1_en" value="2" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="344" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n1_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;ELEVATE&lt;/font&gt;&lt;br&gt;&lt;b&gt;UAC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;WFP needs it — no elevation,&lt;br&gt;no filters&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="252" y="1232" width="200" height="80" as="geometry"/></mxCell><mxCell id="n2_en" value="3" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="546" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n2_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;LOAD&lt;/font&gt;&lt;br&gt;&lt;b&gt;app.ron&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;blocked set, presets,&lt;br&gt;language, interface&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="455" y="1114" width="200" height="80" as="geometry"/></mxCell><mxCell id="n3_en" value="4" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="748" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n3_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;APPLY&lt;/font&gt;&lt;br&gt;&lt;b&gt;WFP filters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;permanent: they stay after&lt;br&gt;exit · session: gone on exit&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="658" y="1232" width="200" height="80" as="geometry"/></mxCell><mxCell id="n4_en" value="5" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="951" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n4_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;FETCH&lt;/font&gt;&lt;br&gt;&lt;b&gt;ips.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;regions and their IP blocks,&lt;br&gt;then every 15 min&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="860" y="1114" width="200" height="80" as="geometry"/></mxCell><mxCell id="n5_en" value="6" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1154" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n5_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;WATCH&lt;/font&gt;&lt;br&gt;&lt;b&gt;game · 0.9 s&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;is Overwatch.exe running? warn&lt;br&gt;before changes&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1062" y="1232" width="200" height="80" as="geometry"/></mxCell><mxCell id="n6_en" value="7" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1356" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n6_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;MEASURE&lt;/font&gt;&lt;br&gt;&lt;b&gt;ping · 15 s&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;one reply of three is enough;&lt;br&gt;silent IPs get a fallback&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1265" y="1114" width="200" height="80" as="geometry"/></mxCell><mxCell id="n7_en" value="8" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1558" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n7_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;CHECK&lt;/font&gt;&lt;br&gt;&lt;b&gt;update · 2.5 h&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;newer release? download, swap,&lt;br&gt;restart&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=top;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1468" y="1232" width="200" height="80" as="geometry"/></mxCell><mxCell id="n8_en" value="9" style="ellipse;fillColor=#f6f7f9;strokeColor=#0f766e;strokeWidth=2;fontColor=#0f766e;fontStyle=1;fontSize=8;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="1761" y="1201" width="18" height="18" as="geometry"/></mxCell><mxCell id="n8_t_en" value="&lt;font style=&quot;font-size:9px&quot; color=&quot;#0f766e&quot;&gt;EXIT&lt;/font&gt;&lt;br&gt;&lt;b&gt;close&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot; color=&quot;#4d5966&quot;&gt;session filters are removed;&lt;br&gt;permanent ones stay&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=center;verticalAlign=bottom;fontSize=11;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1670" y="1114" width="200" height="80" as="geometry"/></mxCell><mxCell id="life_note_en" value="permanent mode: the filters from step 4 stay across launches · session mode: they go at step 9" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=right;verticalAlign=middle;fontSize=10.5;fontColor=#8b95a1;fontFamily=Consolas;" vertex="1" parent="1"><mxGeometry x="40" y