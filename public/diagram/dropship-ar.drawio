ot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;answers, so it is never picked&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1344" y="516" width="208" height="110" as="geometry"/></mxCell><mxCell id="ips_en" value="" style="rounded=1;arcSize=14;html=1;fillColor=#ffffff;strokeColor=#d8dee6;shadow=1;fontSize=1;" vertex="1" parent="1"><mxGeometry x="1580" y="512" width="272" height="118" as="geometry"/></mxCell><mxCell id="ips_i_en" value="" style="shape=image;image=https://ryanathlawi.github.io/dropship-site/diagram/icons/file-json-b16400.svg;" vertex="1" parent="1"><mxGeometry x="1596" y="528" width="20" height="20" as="geometry"/></mxCell><mxCell id="ips_l_en" value="&lt;b&gt;ips.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;region code, IP blocks, ping address&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;— maintained upstream, fetched by&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#4d5966&quot;&gt;every copy every 15 min&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontSize=12;fontColor=#0f1319;" vertex="1" parent="1"><mxGeometry x="1632" y="516" width="208" height="110" as="geometry"/></mxCell><mxCell id="repo_en" value="" style="rounded=1;arcSize=14;html=1;fillColor=#ffffff;strokeColor=#d8dee6;shadow=1;fontSize=1;" vertex="1" parent="1"><mxGeometry x="1292" y="740" width="272" height="84" as="geometry"/></mxCell><mxCell id="repo_i_en" value="" style="shape=image;image=https://ryanathlawi.github.io/dropship-site/diagram/icons/git-branch-5b48a8.svg;" vertex="1" parent="1"><mxGeometry x="1308" y="756" width="20" height="20" as="geometry"/></mxCell><mxCell id="repo_l_en" value="&lt;b&gt;Ryanathlawi/dropship-ar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&qu